# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (HANYA digunakan untuk skrip seed lokal: scripts/seed.ts)
# JANGAN PERNAH menyertakan key ini di sisi client atau aplikasi web Next.js!
# Dapatkan dari Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
