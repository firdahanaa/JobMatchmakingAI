# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_HELPDESK_EMAIL=quadromadagaskar@gmail.com
NEXT_PUBLIC_HELPDESK_EMAIL=quadromadagaskar@gmail.com

# Payment gateway
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Server-only service role key: payment webhook and local seed script only.
# Never expose this key to browser code.
# Dapatkan dari Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
