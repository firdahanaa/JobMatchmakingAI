# Supabase Configuration (Salin nilai ini ke .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_HELPDESK_EMAIL=quadromadagaskar@gmail.com

# Payment gateway: gunakan mock untuk development lokal atau midtrans untuk Snap.
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Service role (server-only): route webhook pembayaran dan scripts/seed.ts.
# Jangan pernah gunakan atau ekspos key ini di browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
